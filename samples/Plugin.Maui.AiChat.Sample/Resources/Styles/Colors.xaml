<?xml version="1.0" encoding="UTF-8" ?>
<!-- The palette: violet, as the logo, with violet-tinted neutrals. Each color has a dark theme variant with the "Dark"
     suffix. Android also reads Platforms/Android/Resources/values/colors.xml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <Color x:Key="Primary">#6D28D9</Color>
  <Color x:Key="PrimaryDark">#A78BFA</Color>
  <Color x:Key="OnPrimary">#FFFFFF</Color>
  <Color x:Key="OnPrimaryDark">#1E1033</Color>

  <Color x:Key="Surface">#FFFFFF</Color>
  <Color x:Key="SurfaceDark">#121016</Color>
  <Color x:Key="Card">#F5F3FA</Color>
  <Color x:Key="CardDark">#1C1922</Color>
  <Color x:Key="Outline">#E2DEEA</Color>
  <Color x:Key="OutlineDark">#34303D</Color>

  <Color x:Key="Text">#18151F</Color>
  <Color x:Key="TextDark">#EDEAF3</Color>
  <Color x:Key="TextMuted">#6B6578</Color>
  <Color x:Key="TextMutedDark">#A39DB0</Color>

</ResourceDictionary>
